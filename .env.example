VITE_AUTH_MODE=demo
# Demo mode uses localStorage sample data and does not need Supabase, API, or PostgreSQL.
# Set VITE_AUTH_MODE=supabase to use Supabase Auth with the local API/PostgreSQL database.

# Frontend Supabase values are used for Auth only.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_SUPABASE_PASSWORD_RESET_REDIRECT_URL=http://127.0.0.1:5173/login?reset=1
VITE_API_BASE_URL=http://127.0.0.1:8787/api

# API Supabase values are used only to verify Supabase Auth access tokens.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# Local PostgreSQL stores all business/application data. Use npm run db:start for Docker.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/footwear_production_hub
API_PORT=8787
CORS_ORIGIN=http://127.0.0.1:5173
UPLOADS_DIR=uploads
ALLOW_DESTRUCTIVE_ADMIN_ACTIONS=false

# Local server files for generated documents. These stay on the API/server machine.
SERVER_FILES_DIR=server-files
COMPANY_NAME=Footwear Production Hub

# Optional retention command settings for npm run db:retention.
RETENTION_ARCHIVE_OLDER_THAN_YEARS=2
# Leave blank unless you intentionally want to delete already-archived records.
RETENTION_DELETE_ARCHIVED_OLDER_THAN_YEARS=

# SMTP is used only by the Express API for Material PO vendor emails.
# Leave blank for demo mode or until factory email is configured.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
