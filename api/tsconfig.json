{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "allowImportingTsExtensions": false,
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": false,
    "outDir": "dist",
    "rootDir": "..",
    "types": ["node"],
    "verbatimModuleSyntax": true
  },
  "include": ["src/**/*.ts", "../src/lib/domain.ts"]
}
